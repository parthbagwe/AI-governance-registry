# Copy this file to .env.local and adjust as needed.
#
# Local development (FastAPI running via `python -m uvicorn app.main:app --reload`):
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
#
# For the Vercel deployment, don't put the production URL here — set it in
# Vercel's dashboard instead (Project Settings -> Environment Variables), as:
#   NEXT_PUBLIC_API_URL=https://<your-service>.onrender.com/api/v1
#
# Note the /api/v1 suffix. Without it every request 404s, because the routes
# are mounted under that prefix in app/main.py.
#
# NEXT_PUBLIC_ variables are compiled into the browser bundle and are visible
# to anyone who opens devtools. That's fine for an API base URL and would not
# be fine for a secret — never put a key behind this prefix.

# The site's own public URL. Used for canonical links, robots.txt, the sitemap,
# and — most importantly — to make the Open Graph share image resolve to an
# absolute path. Without it, link previews on LinkedIn and elsewhere come back
# blank, because no platform can fetch a relative image URL.
#
# Set this in Vercel to your deployed domain, e.g.
#   NEXT_PUBLIC_SITE_URL=https://ai-governance-registry.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
