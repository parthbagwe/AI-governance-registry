# Copy this file to `.env` and fill in your own key.
# `.env` is gitignored — never commit a real key.
#
# Free key (800 requests/day, no card required):
#   https://twelvedata.com/pricing
TWELVEDATA_API_KEY=your-key-here

# Authentication (backend). The frontend uses the corresponding public values
# from frontend/.env.local. Never put a Supabase service-role key in either file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_ADMIN_EMAILS=you@example.com

# Server-only credential for automated drift monitors. Generate a long random
# value and use the same value as REGISTRY_API_KEY on the monitor host.
MONITOR_API_KEY=
REGISTRY_API_KEY=
MONITOR_ACTOR=governance-monitor-service
