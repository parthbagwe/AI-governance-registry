# Virtual environment
.venv/
venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Database (generated by seed.py — don't commit real/local data)
governance.db
*.db
*.sqlite3

# Trained model artifacts (regenerated by train_model.py)
*.pkl

# Synthetic datasets (regenerated by generate_data.py)
data_train.csv
data_current.csv

# Live-feed snapshots (regenerated by app/ml/live_feed.py — and a stale one
# would be misleading, since the whole point is that it's captured fresh)
live_baseline.csv
intraday_baseline.csv

# API keys. Never commit these — a leaked key is someone else's quota,
# or worse, on a paid tier.
.env
.env.*
!.env.example

# Streamlit
.streamlit/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Frontend (Next.js)
node_modules/
frontend/.next/
frontend/out/
frontend/.vercel
frontend/next-env.d.ts
*.tsbuildinfo
.env
.env.local